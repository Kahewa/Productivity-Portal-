{
  "entities": {
    "UserData": {
      "title": "User Task Data",
      "description": "Stores habits, weekly schedule, and reset information for Grace.",
      "type": "object",
      "properties": {
        "habits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "completed": { "type": "object" }
            }
          }
        },
        "weeklySchedule": {
          "type": "object",
          "description": "Map of days to their classes and tasks."
        },
        "lastResetDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["habits", "weeklySchedule", "lastResetDate"]
    },
    "PeriodData": {
      "title": "Period Tracker Data",
      "description": "Stores the start and end dates of the period and cycle length.",
      "type": "object",
      "properties": {
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "cycleLength": { "type": "integer" }
      },
      "required": ["cycleLength"]
    },
    "ActivitiesData": {
      "title": "Calendar Activities",
      "description": "List of calendar activities and events.",
      "type": "object",
      "properties": {
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "time": { "type": "string" },
              "date": { "type": "string" },
              "category": { "type": "string" }
            }
          }
        }
      },
      "required": ["activities"]
    },
    "BrainConfigData": {
      "title": "Brain Profile and Custom Highlights Configuration",
      "description": "Customizable profile photo, title, and the 5 interactive popup icons details, containers, and colors.",
      "type": "object",
      "properties": {
        "photoUrl": { "type": "string" },
        "profileTitle": { "type": "string" },
        "icons": { "type": "object" }
      },
      "required": ["photoUrl", "icons"]
    },
    "ThemeData": {
      "title": "Theme Preference",
      "description": "Selected visual theme for the planner.",
      "type": "object",
      "properties": {
        "theme": { "type": "string" }
      },
      "required": ["theme"]
    }
  },
  "firestore": {
    "/trackers/grace": {
      "schema": "UserData",
      "description": "Grace's habits and weekly timetable data."
    },
    "/trackers/period": {
      "schema": "PeriodData",
      "description": "Grace's menstrual cycle tracking data."
    },
    "/trackers/activities": {
      "schema": "ActivitiesData",
      "description": "Grace's events and calendar activities."
    },
    "/trackers/brainConfig": {
      "schema": "BrainConfigData",
      "description": "Grace's customized profile photo and 5 life icons configuration."
    },
    "/trackers/theme": {
      "schema": "ThemeData",
      "description": "Grace's selected UI theme."
    }
  }
}
